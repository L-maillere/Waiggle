root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Les scripts PowerShell gardent leur marqueur UTF-8 (« BOM ») : sans lui, Windows PowerShell 5.1
# lit les lettres accentuées de travers.
[*.ps1]
charset = utf-8-bom
