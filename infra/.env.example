# Copier en infra/.env puis remplir. Ne jamais committer infra/.env.

# Domaine public de l'API (localhost en local)
API_DOMAIN=localhost
# Adresses complètes de l'API et de l'appli web (liens des e-mails, origine autorisée)
PUBLIC_API_URL=https://localhost
APP_URL=http://localhost:8081

# Base de données : mot de passe long et aléatoire, sans caractères spéciaux (openssl rand -hex 32)
POSTGRES_DB=ruche
POSTGRES_USER=ruche
POSTGRES_PASSWORD=

# Clé secrète des sessions, 32 caractères minimum : openssl rand -base64 32
BETTER_AUTH_SECRET=

# E-mails : "console" (affichés dans les logs) ou "brevo" (envoi réel, clé API Brevo requise)
MAIL_PROVIDER=console
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@example.com
# Nom de l'expéditeur. Vide : le nom de l'appli (packages/brand/src/name.ts)
MAIL_FROM_NAME=

# Code d'invitation demandé à l'inscription : au moins 12 caractères, majuscules et espaces autour
# ignorés. Le donner à ses proches, ou leur envoyer le lien https://<domaine>/sign-up?code=<code>.
SIGNUP_INVITE_CODE=

# Version affichée par /health
APP_VERSION=dev
