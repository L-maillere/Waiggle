# Copier en infra/.env puis remplir. Ne jamais committer infra/.env.

# Domaine public de l'API (localhost en local)
API_DOMAIN=localhost

# Base de données : choisir un mot de passe long et aléatoire (ex. openssl rand -base64 32)
POSTGRES_DB=ruche
POSTGRES_USER=ruche
POSTGRES_PASSWORD=

# Version affichée par /health
APP_VERSION=dev
